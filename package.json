    "react-dom": "18.3.1",
    "react-i18next": "15.2.0",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
